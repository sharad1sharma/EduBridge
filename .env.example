# Copy to .env and edit. NEVER commit .env. Placeholders only below.

# Local development: True. Production: False (and set the values below).
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=31536000
# DJANGO_BEHIND_TLS_PROXY=True

# Database (SQLite by default). For PostgreSQL:
# DB_ENGINE=postgres
# DB_NAME=edubridge
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Session idle timeout in minutes (default 120)
# SESSION_IDLE_MINUTES=120

# Email for password reset. Default prints emails to the console.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=EduBridge <no-reply@your-domain.example>

# One-off admin bootstrap only (prefer the interactive prompt; unset afterwards):
# EDUBRIDGE_ADMIN_PASSWORD=

# --- Cohere AI Assistant Integration ------------------------------------------
# Set your server-side Cohere API Key from https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025

